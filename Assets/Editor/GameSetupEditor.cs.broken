    [MenuItem("Tools/Game Setup/01. GameOver Scene 繧剁E��懈�E")]
    public static void CreateGameOverScene()
    {
        if (System.IO.File.Exists(GameOverScenePath))
        {
            if (!EditorUtility.DisplayDialog(
