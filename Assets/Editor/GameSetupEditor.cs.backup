        // Save scene
        EditorSceneManager.SaveScene(scene, TitleScenePath);
        EditorSceneManager.OpenScene(TitleScenePath);

        EditorUtility.DisplayDialog(
            "Complete",
            $"TitleScene created.\n{TitleScenePath}\n\nStart button -> GameScene load is implemented.\nNote: EventSystem uses InputSystem project set to InputSystemUIInputModule.",
            "OK");
