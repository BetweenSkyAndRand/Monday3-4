        // 笏笏 Step 13: BuildModeToggleObject 縺�E� searchController 險�E�螳・笏笏
        // 謗｢邏｢荳�E�縺�E�繝薙Ν繝峨Δ繝ｼ繝峨∈蜈�E�繧後�E縺・�E�縺・。uildModeToggleObject 縺�E� SearchController 繧定ｨ�E�螳壹☁E��九・
        var buildModeToggleObject = Object.FindFirstObjectByType<BuildModeToggleObject>();
        if (buildModeToggleObject != null)
        {
