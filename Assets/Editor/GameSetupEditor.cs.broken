    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 7. GameScene 繝�Eャ繧�E�繧�E�繝�E・繧呈�E蜍穂ｽ懈�E
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/07. GameScene 繝�Eャ繧�E�繧�E�繝�E・繧剁E��懈�E")]
    public static void CreateGameSceneBackupMenu()
    {
        if (!System.IO.File.Exists(GameScenePath))
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        var backupPath = CreateGameSceneBackup();
        if (backupPath != null)
        {
            EditorUtility.DisplayDialog("螳御�E�・, $"繝�Eャ繧�E�繧�E�繝�E・繧剁E��懈�E縺励∪縺励◁E��・n{backupPath}", "OK");
        }
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 8. 譌｢蟁E��す繝ｼ繝ｳ縺�E� InputModule 繧・InputSystem 蟁E��蠢懊�E蟾�E�縺玲崛縺・
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/08. InputModule 繧・InputSystem 蟁E��蠢懊�E蟾�E�縺玲崛縺茨�E�域里蟁E��す繝ｼ繝ｳ菫�E�豁E��・・)]
    public static void FixInputModuleForAllScenes()
    {
        var targetScenes = new[]
        {
            TitleScenePath,
            GameOverScenePath,
            GameClearScenePath,
        };

        var log = new System.Text.StringBuilder();
        log.AppendLine("[GameSetupEditor] InputModule 蟾�E�縺玲崛縺磯幕蟋・);
        log.AppendLine("笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏");

        foreach (var scenePath in targetScenes)
        {
            if (!System.IO.File.Exists(scenePath))
            {
                log.AppendLine("Log entry");
                continue;
            }

            var scene = EditorSceneManager.OpenScene(scenePath, OpenSceneMode.Additive);
            SceneManager.SetActiveScene(scene);

            FixInputModuleInScene(scenePath, log);

            EditorSceneManager.SaveScene(scene);
            // 蜁E��送E�E�E�後�E繧�E�繝ｼ繝ｳ繧帝哩縺倥※繝｡繝｢繝ｪ繧定ｧ�E�謾�E�縺吶�E��E・ameScene縺�E�蟁E��雎｡螟悶↑縺�E�縺�E�螳牙�E縺�E�髢峨§繧峨�E�繧具�E�・
            EditorSceneManager.CloseScene(scene, removeScene: true);
        }

        AssetDatabase.Refresh();
        var logText = log.ToString();
        Debug.Log(logText);
        EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
    }

    /// <summary>
    /// 繧�E�繧�E�繝�EぁE��悶す繝ｼ繝ｳ蜀・・ StandaloneInputModule 繧・InputSystemUIInputModule 縺�E�蟾�E�縺玲崛縺医�E�縲・
    /// 譌｢縺�E�InputSystemUIInputModule 縺悟ｭ伜惠縺吶�E�蝣�E�蜷医・繧�E�繧�E�繝�E・縺吶�E�縲・
    /// </summary>
    private static void FixInputModuleInScene(string sceneName, System.Text.StringBuilder log)
    {
        // 譌｢縺�E� InputSystemUIInputModule 縺悟ｭ伜惠縺吶�E�蝣�E�蜷医・繧�E�繧�E�繝�E・
        var existingModule = Object.FindFirstObjectByType<InputSystemUIInputModule>();
        if (existingModule != null)
        {
            log.AppendLine($"邁E�� {sceneName}: InputSystemUIInputModule 縺�E�譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
            return;
        }

        var standaloneModule = Object.FindFirstObjectByType<StandaloneInputModule>();
        if (standaloneModule == null)
        {
            log.AppendLine($"笞 {sceneName}: StandaloneInputModule 縺瑚ｦ九▽縺九ｊ縺�E�縺帙ｓ縺�E�縺励◁E��・);
            return;
        }

        // StandaloneInputModule 縺悟ｭ伜惠縺吶�E�EGameObject 縺�E� InputSystemUIInputModule 繧定ｿ�E�蜉縺励※蜑企勁縺吶�E�E
        var eventSystemGo = standaloneModule.gameObject;
        Object.DestroyImmediate(standaloneModule);
        eventSystemGo.AddComponent<InputSystemUIInputModule>();
        log.AppendLine($"笨・{sceneName}: StandaloneInputModule 竊�EInputSystemUIInputModule 縺�E�蟾�E�縺玲崛縺医∪縺励◁E��・);
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 9. 譌･譛ｬ隱槭ヵ繧�E�繝ｳ繝医そ繝�Eヨ繧�E�繝�E・・・ynamic TMP FontAsset 菴懈�E・・
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/09. 譌･譛ｬ隱槭ヵ繧�E�繝ｳ繝医そ繝�Eヨ繧�E�繝�E・・・ynamic TMP FontAsset 菴懈�E・・)]
    public static void SetupJapaneseFont()
    {
        // Fonts 繝輔か繝ｫ繝繧堤�E��E�隱阪・菴懈�E
        if (!AssetDatabase.IsValidFolder("Assets/Game/Fonts"))
        {
            AssetDatabase.CreateFolder("Assets/Game", "Fonts");
        }

        // Windows 貂ｸ繧�E�繧�E�繝�Eけ繧偵さ繝斐・・亥�E�伜惠縺吶�E�蝣�E�蜷医・縺�E�・・
        if (!System.IO.File.Exists(JapaneseFontDestPath))
        {
            if (System.IO.File.Exists(JapaneseFontSourcePath))
            {
                System.IO.File.Copy(JapaneseFontSourcePath, JapaneseFontDestPath);
                AssetDatabase.Refresh();
                Debug.Log($"[GameSetupEditor] 貂ｸ繧�E�繧�E�繝�Eけ繧偵さ繝斐・縺励∪縺励◁E {JapaneseFontDestPath}");
            }
            else
            {
                EditorUtility.DisplayDialog("Info", "Operation completed", "OK")}\n" +
                    "縺�E�繧�E�繝斐・縺励※縺九ｉ縲√！E���E�繝｡繝九Η繝ｼ繧貞�E螳溯�E�後＠縺�E�縺上□縺輔＞縲・n\n" +
                    "謗ｨ螂ｨ繝輔か繝ｳ繝�E 貂ｸ繧�E�繧�E�繝�Eけ繝ｻNoto Sans JP",
                    "OK");
                return;
            }
        }

        // 縺吶〒縺�E� TMP FontAsset 縺悟ｭ伜惠縺吶�E�蝣�E�蜷医・繧�E�繧�E�繝�E・
        if (System.IO.File.Exists(JapaneseFontAssetPath))
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        // Font 繧偵Ο繝ｼ繝峨�E�縺�E� Dynamic TMP FontAsset 繧剁E��懈�E
        var sourceFont = AssetDatabase.LoadAssetAtPath<Font>(JapaneseFontDestPath);
        if (sourceFont == null)
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        // Dynamic 繝｢繝ｼ繝峨、ETMP FontAsset 繧剁E��懈�E・井ｽ�E�逕ｨ縺励◁E���E�繝ｪ繝輔′蜍�E噪縺�E�霑ｽ蜉縺輔ｌ繧具�E�・
        // 繧�E�繝ｳ繝励Ν縺�E�繧�E�繝ｼ繝�E・繝ｭ繝ｼ繝峨〒菴懈�E縺励�E�ynamic 險�E�螳壹・繝励Ο繝代ユ繧�E�縺�E�蠕御�E�倥�E�縺吶�E�E
        var fontAsset = TMP_FontAsset.CreateFontAsset(sourceFont);
        if (fontAsset == null)
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        // Dynamic 繝輔か繝ｳ繝医→縺励※險�E�螳夲�E�井ｽ�E�逕ｨ縺吶�E�繧�E�繝ｪ繝輔�E縺�E�繧貞虚逧・↓霑�E�蜉縺怜ｮ�E�驥上ｒ遽邏�E☁E��具�E�・
        fontAsset.atlasPopulationMode = AtlasPopulationMode.Dynamic;

        fontAsset.name = System.IO.Path.GetFileNameWithoutExtension(JapaneseFontAssetPath);
        AssetDatabase.CreateAsset(fontAsset, JapaneseFontAssetPath);
        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();

        EditorUtility.DisplayDialog("Info", "Operation completed", "OK");

        Debug.Log($"[GameSetupEditor] 譌･譛ｬ隱・Dynamic TMP FontAsset 繧剁E��懈�E縺励∪縺励◁E {JapaneseFontAssetPath}");
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 10. LocalizationData 繧�E�繧�E�繝�Eヨ菴懈�E
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/10. LocalizationData 繧�E�繧�E�繝�Eヨ菴懈�E")]
    public static void CreateLocalizationDataAsset()
    {
        if (System.IO.File.Exists(LocalizationDataPath))
        {
            if (!EditorUtility.DisplayDialog(
                    "遒ｺ隱・,
                    $"{LocalizationDataPath} 縺�E�譌｢縺�E�蟁E��惠縺励∪縺吶めE��頑嶌縺阪�E�縺�E�縺吶°・・,
                    "荳頑嶌縺・, "繧�E�繝｣繝ｳ繧�E�繝ｫ"))
            {
                return;
            }

            AssetDatabase.DeleteAsset(LocalizationDataPath);
        }

        var data = ScriptableObject.CreateInstance<LocalizationData>();
        AssetDatabase.CreateAsset(data, LocalizationDataPath);

        // 繝�Eヵ繧�E�繝ｫ繝医お繝ｳ繝医Μ繧・ScriptableObject 縺�E�險�E�螳壹☁E��・
        var serializedData = new SerializedObject(data);
        var entriesProp    = serializedData.FindProperty("entries");
        if (entriesProp != null && entriesProp.isArray)
        {
            var defaultEntries = new (string key, string ja, string en)[]
            {
                (LocalizationKey.TitleLabel,       "MapTest",              "MapTest"),
                (LocalizationKey.GameStart,        "繧�E�繝ｼ繝繧�E�繧�E�繝ｼ繝�E,        "Game Start"),
                (LocalizationKey.LanguageJapanese, "譌･譛ｬ隱・,               "譌･譛ｬ隱・),
                (LocalizationKey.LanguageEnglish,  "English",              "English"),
                (LocalizationKey.ReturnToTitle,    "繧�E�繧�E�繝医Ν縺�E�謌ｻ繧・,        "Return to Title"),
                (LocalizationKey.GameOver,         "GAME OVER",            "GAME OVER"),
                (LocalizationKey.GameClear,        "GAME CLEAR",           "GAME CLEAR"),
                (LocalizationKey.FinalInventory,   "縲先怙邨めE�E謖�E■迚ｩ縲・,       "縲色inal Inventory縲・),
                (LocalizationKey.SearchEnd,        "謗｢邏｢邨めE��・,              "SearchEnd"),
                (LocalizationKey.Build,            "繝薙Ν繝�E,               "Build"),
            };

            entriesProp.arraySize = defaultEntries.Length;
            for (var i = 0; i < defaultEntries.Length; i++)
            {
                var element = entriesProp.GetArrayElementAtIndex(i);
                element.FindPropertyRelative("key").stringValue      = defaultEntries[i].key;
                element.FindPropertyRelative("japanese").stringValue = defaultEntries[i].ja;
                element.FindPropertyRelative("english").stringValue  = defaultEntries[i].en;
            }

            serializedData.ApplyModifiedProperties();
        }

        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();

        // Inspector 縺�E�繧�E�繧�E�繝�Eヨ繧帝�E謚樒�E諷九�E縺吶�E�E
        Selection.activeObject = data;

        Debug.Log($"[GameSetupEditor] LocalizationData 繧剁E��懈�E縺励∪縺励◁E {LocalizationDataPath}");
        EditorUtility.DisplayDialog(
            "LocalizationData 菴懈�E螳御�E�・,
            $"菴懈�E縺励∪縺励◁E {LocalizationDataPath}\n\n" +
            "Inspector 縺�E�繝�Eく繧�E�繝医�E�遒�E�隱阪・邱�E�髮・�E�縺�E�縺上□縺輔＞縲・n" +
            "LanguageManager 繧�E�繝ｳ繝昴・繝阪Φ繝医・ 'Localization Data' 縺�E�繧�E�繧�E�繧�E�繝ｳ縺励※縺上□縺輔＞縲・,
            "OK");
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 11. TitleScene 縺�E�險隱槫・繧頑崛縺・UI 閾�E�蜍�E�E��E�蜉
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/11. TitleScene 縺�E�險隱槫・繧頑崛縺・UI 霑ｽ蜉")]
    public static void AddLanguageUIToTitleScene()
    {
        if (!System.IO.File.Exists(TitleScenePath))
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        // LocalizationData 縺�E�蟁E��惠遒ｺ隱・
        var localizationData = AssetDatabase.LoadAssetAtPath<LocalizationData>(LocalizationDataPath);
        if (localizationData == null)
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        var scene = EditorSceneManager.OpenScene(TitleScenePath, OpenSceneMode.Additive);
        SceneManager.SetActiveScene(scene);

        var log = new System.Text.StringBuilder();
        log.AppendLine("[GameSetupEditor] TitleScene 險隱朸I霑ｽ蜉髢句�E�・);

        // 笏笏 Step 1: LanguageManager 繧堤�E��E�隱阪・菴懈�E 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var languageManager = Object.FindFirstObjectByType<LanguageManager>();
        if (languageManager == null)
        {
            var lmGo = new GameObject("LanguageManager");
            languageManager = lmGo.AddComponent<LanguageManager>();
            log.AppendLine("笨・LanguageManager 繧�E�繝悶ず繧�E�繧�E�繝医�E�菴懈�E縺励∪縺励◁E��・);
        }
        else
        {
            log.AppendLine("邁E�� LanguageManager 縺�E�譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
        }

        // LocalizationData 繧偵ぁE���E�繧�E�繝ｳ
        var serializedLm = new SerializedObject(languageManager);
        AssignProperty(serializedLm, "localizationData", localizationData, log, "LanguageManager.localizationData");
        serializedLm.ApplyModifiedProperties();

        // 笏笏 Step 2: Canvas 繧貞叙蠕�E笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var canvas = Object.FindFirstObjectByType<Canvas>();
        if (canvas == null)
        {
            log.AppendLine("笞 Canvas 縺瑚ｦ九▽縺九ｊ縺�E�縺帙ｓ縲�E�itleScene 繧貞�E菴懈�E縺励※縺上□縺輔＞縲・);
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            EditorSceneManager.CloseScene(scene, false);
            return;
        }

        // 笏笏 Step 3: TitleLanguageView 繧堤�E��E�隱阪・菴懈�E 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var titleLanguageView = Object.FindFirstObjectByType<TitleLanguageView>();
        if (titleLanguageView == null)
        {
            // LanguageView 逕ｨ縺�E�繝代ロ繝ｫ繧剁E��懈�E
            var languageViewGo = new GameObject("LanguageView");
            languageViewGo.transform.SetParent(canvas.transform, false);
            var rectTransform = languageViewGo.AddComponent<RectTransform>();
            rectTransform.anchorMin = new Vector2(0.5f, 0.1f);
            rectTransform.anchorMax = new Vector2(0.5f, 0.1f);
            rectTransform.sizeDelta = new Vector2(400f, 60f);
            rectTransform.anchoredPosition = Vector2.zero;

            // 譌･譛ｬ隱槭・繧�E�繝ｳ
            var japaneseButtonGo = CreateUIChild(languageViewGo, "JapaneseButton");
            var japaneseRect = japaneseButtonGo.GetComponent<RectTransform>();
            japaneseRect.anchorMin = new Vector2(0f, 0.5f);
            japaneseRect.anchorMax = new Vector2(0f, 0.5f);
            japaneseRect.sizeDelta = new Vector2(180f, 50f);
            japaneseRect.anchoredPosition = new Vector2(90f, 0f);
            var japaneseImage = japaneseButtonGo.AddComponent<Image>();
            japaneseImage.color = new Color(0.4f, 0.4f, 0.4f);
            var japaneseButton = japaneseButtonGo.AddComponent<Button>();
            japaneseButton.targetGraphic = japaneseImage;

            var japaneseTextGo = CreateUIChild(japaneseButtonGo, "Text");
            SetAnchorFill(japaneseTextGo);
            var japaneseText = japaneseTextGo.AddComponent<TextMeshProUGUI>();
            japaneseText.text = "譌･譛ｬ隱・;
            japaneseText.fontSize = 28;
            japaneseText.alignment = TextAlignmentOptions.Center;
            japaneseText.color = Color.white;

            // 闍ｱ隱槭・繧�E�繝ｳ
            var englishButtonGo = CreateUIChild(languageViewGo, "EnglishButton");
            var englishRect = englishButtonGo.GetComponent<RectTransform>();
            englishRect.anchorMin = new Vector2(1f, 0.5f);
            englishRect.anchorMax = new Vector2(1f, 0.5f);
            englishRect.sizeDelta = new Vector2(180f, 50f);
            englishRect.anchoredPosition = new Vector2(-90f, 0f);
            var englishImage = englishButtonGo.AddComponent<Image>();
            englishImage.color = new Color(0.4f, 0.4f, 0.4f);
            var englishButton = englishButtonGo.AddComponent<Button>();
            englishButton.targetGraphic = englishImage;

            var englishTextGo = CreateUIChild(englishButtonGo, "Text");
            SetAnchorFill(englishTextGo);
            var englishText = englishTextGo.AddComponent<TextMeshProUGUI>();
            englishText.text = "English";
            englishText.fontSize = 28;
            englishText.alignment = TextAlignmentOptions.Center;
            englishText.color = Color.white;

            // TitleLanguageView 繧偵ぁE���E�繝�Eメ縺励※蜿ら�E險�E�螳・
            titleLanguageView = languageViewGo.AddComponent<TitleLanguageView>();
            var serializedView = new SerializedObject(titleLanguageView);
            AssignProperty(serializedView, "japaneseButton", japaneseButton, log, "TitleLanguageView.japaneseButton");
            AssignProperty(serializedView, "englishButton", englishButton, log, "TitleLanguageView.englishButton");
            serializedView.ApplyModifiedProperties();

            log.AppendLine("笨・TitleLanguageView 縺�E�險隱槫・繧頑崛縺医・繧�E�繝ｳ繧剁E��懈�E縺励∪縺励◁E��・);
        }
        else
        {
            log.AppendLine("邁E�� TitleLanguageView 縺�E�譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
        }

        EditorSceneManager.SaveScene(scene);
        EditorSceneManager.CloseScene(scene, false);
        AssetDatabase.Refresh();

        var logText = log.ToString();
        Debug.Log(logText);
        EditorUtility.DisplayDialog("TitleScene 險隱朸I霑ｽ蜉螳御�E�・, logText, "OK");
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 12. GameScene 縺�E� LanguageManager 霑ｽ蜉
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/12. GameScene 縺�E� LanguageManager 霑ｽ蜉")]
    public static void AddLanguageManagerToGameScene()
    {
        if (!System.IO.File.Exists(GameScenePath))
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        // LocalizationData 縺�E�蟁E��惠遒ｺ隱・
        var localizationData = AssetDatabase.LoadAssetAtPath<LocalizationData>(LocalizationDataPath);
        if (localizationData == null)
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        var activeScene = SceneManager.GetActiveScene();
        var gameScene = activeScene.path == GameScenePath
            ? activeScene
            : EditorSceneManager.OpenScene(GameScenePath, OpenSceneMode.Additive);

        if (activeScene.path != GameScenePath)
        {
            SceneManager.SetActiveScene(gameScene);
        }

        var log = new System.Text.StringBuilder();
        log.AppendLine("[GameSetupEditor] GameScene LanguageManager 霑ｽ蜉髢句�E�・);

        // LanguageManager 繧堤�E��E�隱阪・菴懈�E
        var languageManager = Object.FindFirstObjectByType<LanguageManager>();
        if (languageManager == null)
        {
            var lmGo = new GameObject("LanguageManager");
            languageManager = lmGo.AddComponent<LanguageManager>();
            log.AppendLine("笨・LanguageManager 繧�E�繝悶ず繧�E�繧�E�繝医�E�菴懈�E縺励∪縺励◁E��・);
        }
        else
        {
            log.AppendLine("邁E�� LanguageManager 縺�E�譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
        }

        // LocalizationData 繧偵ぁE���E�繧�E�繝ｳ
        var serializedLm = new SerializedObject(languageManager);
        AssignProperty(serializedLm, "localizationData", localizationData, log, "LanguageManager.localizationData");
        serializedLm.ApplyModifiedProperties();

        EditorSceneManager.SaveScene(gameScene);
        AssetDatabase.Refresh();

        var logText = log.ToString();
        Debug.Log(logText);
        EditorUtility.DisplayDialog("GameScene LanguageManager 霑ｽ蜉螳御�E�・, logText, "OK");
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 螳晉ｮ�E�繝励Ξ繝上ヶ菴懈�E・亥・驛ｨ蜈ｱ騾壼・送E�E�E�・
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    /// <summary>螳晉ｮ�E�繝励Ξ繝上ヶ繧剁E��懈�E縺励※繝ｭ繧�E�縺�E�險倬鹸縺吶�E��E医Γ繝九Η繝ｼ5 縺�E� Step 1 縺�E�蜈ｱ騾壼・送E�E�E�峨・/summary>
    private static void CreateTreasureBoxPrefabInternal(System.Text.StringBuilder log)
    {
        const string prefabFolder = "Assets/Game/Room/Prefabs";
        if (!AssetDatabase.IsValidFolder(prefabFolder))
        {
            AssetDatabase.CreateFolder("Assets/Game/Room", "Prefabs");
        }

        var treasureBoxGo = new GameObject("TreasureBox");
        var meshFilter = treasureBoxGo.AddComponent<MeshFilter>();
        meshFilter.sharedMesh = Resources.GetBuiltinResource<Mesh>("Cube.fbx");
        var meshRenderer = treasureBoxGo.AddComponent<MeshRenderer>();
        var redMaterial = new Material(Shader.Find("Universal Render Pipeline/Lit"));
        redMaterial.color = new Color(0.8f, 0.1f, 0.1f);
        meshRenderer.sharedMaterial = redMaterial;
        treasureBoxGo.transform.localScale = new Vector3(0.8f, 0.6f, 0.8f);
        treasureBoxGo.AddComponent<BoxCollider>();
        treasureBoxGo.AddComponent<TreasureBoxController>();

        var prefab = PrefabUtility.SaveAsPrefabAsset(treasureBoxGo, TreasureBoxPrefabPath);
        Object.DestroyImmediate(treasureBoxGo);

        if (prefab != null)
        {
            log?.AppendLine($"笨・螳晉ｮ�E�繝励Ξ繝上ヶ繧剁E��懈�E縺励∪縺励◁E {TreasureBoxPrefabPath}");
        }
        else
        {
            log?.AppendLine($"笶・螳晉ｮ�E�繝励Ξ繝上ヶ縺�E�菴懈�E縺�E�螟ｱ謨励�E�縺�E�縺励◁E {TreasureBoxPrefabPath}");
        }
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // Private 繝倥Ν繝代・
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    /// <summary>
    /// SerializedObject 縺�E�繝励Ο繝代ユ繧�E�縺�E�繧�E�繝悶ず繧�E�繧�E�繝亥盾辣�E�繧偵ぁE���E�繧�E�繝ｳ縺吶�E�繝倥Ν繝代・縲・
    /// </summary>
    private static void AssignProperty(SerializedObject serializedObj, string propertyName,
        Object value, System.Text.StringBuilder log, string displayName)
    {
        var prop = serializedObj.FindProperty(propertyName);
        if (prop != null)
        {
            prop.objectReferenceValue = value;
            log.AppendLine($"笨・{displayName} 繧偵ぁE���E�繧�E�繝ｳ縺励∪縺励◁E��・);
        }
        else
        {
            log.AppendLine($"笞 {displayName} 繝輔ぅ繝ｼ繝ｫ繝峨′隕九▽縺九ｊ縺�E�縺帙ｓ�E域�E蜍輔〒繧�E�繧�E�繧�E�繝ｳ縺励※縺上□縺輔＞�E峨・);
        }
    }

    /// <summary>
    /// 驟榊�E繝励Ο繝代ユ繧�E�縺�E�謖�E�E�壹が繝悶ず繧�E�繧�E�繝医′蜷�E�縺�E�繧後※縺・↑縺代�E�縺�E�霑ｽ蜉縺吶�E�繝倥Ν繝代・縲・
    /// </summary>
    private static void SetBlockerIfAbsent(SerializedObject serializedObj, string propertyName,
        Object value, System.Text.StringBuilder log, string displayName)
    {
        var prop = serializedObj.FindProperty(propertyName);
        if (prop == null || !prop.isArray)
        {
            log.AppendLine($"笞 {displayName} 繝輔ぅ繝ｼ繝ｫ繝峨′隕九▽縺九ｊ縺�E�縺帙ｓ縲・);
            return;
        }

        for (var i = 0; i < prop.arraySize; i++)
        {
            if (prop.GetArrayElementAtIndex(i).objectReferenceValue == value)
            {
                log.AppendLine($"邁E�� {displayName} 縺�E�險�E�螳壽�E�医∩縺�E�縺呻�E�医せ繧�E�繝�E・・峨・);
                return;
            }
        }

        prop.arraySize = 1;
        prop.GetArrayElementAtIndex(0).objectReferenceValue = value;
        log.AppendLine($"笨・{displayName}[0] 竊�E{value.GetType().Name}");
    }

    /// <summary>
    /// GameScene 繧偵ち繧�E�繝繧�E�繧�E�繝ｳ繝嶺�E�倥″縺�E� Backups 繝輔か繝ｫ繝縺�E�繧�E�繝斐・縺吶�E�縲・
    /// 繧�E�繝�Eヨ繧�E�繝�E・蜑阪・迥�E�諷九ｒ菫晏ｭ倥�E�縺�E�縺翫�E�縺薙�E縺�E�縲∬�E��E�縺�E�縺溯�E��E�螳壼�E�画峩繧貞�E縺�E�謌ｻ縺帙ｋ縲・
    /// </summary>
    /// <returns>菴懈�E縺励◁E���Eャ繧�E�繧�E�繝�E・縺�E�繧�E�繧�E�繝�Eヨ繝代せ縲めE���E�謨励�E�縺溷�E��E�蜷医・ null縲・/returns>
    private static string CreateGameSceneBackup()
    {
        if (!System.IO.File.Exists(GameScenePath))
        {
            Debug.LogWarning($"[GameSetupEditor] 繝�Eャ繧�E�繧�E�繝�E・蜈�E・繧�E�繝ｼ繝ｳ縺瑚ｦ九▽縺九ｊ縺�E�縺帙ａE {GameScenePath}");
            return null;
        }

        // Backups 繝輔か繝ｫ繝繧堤�E��E�隱阪・菴懈�E
        if (!AssetDatabase.IsValidFolder(BackupSceneFolder))
        {
            AssetDatabase.CreateFolder("Assets/Scenes", "Backups");
            Debug.Log($"[GameSetupEditor] 繝�Eャ繧�E�繧�E�繝�E・繝輔か繝ｫ繝繧剁E��懈�E縺励∪縺励◁E {BackupSceneFolder}");
        }

        var timestamp = System.DateTime.Now.ToString("yyyyMMdd_HHmmss");
        var backupPath = $"{BackupSceneFolder}/GameScene_Backup_{timestamp}.unity";

        var result = AssetDatabase.CopyAsset(GameScenePath, backupPath);
        if (result)
        {
            AssetDatabase.Refresh();
            Debug.Log($"[GameSetupEditor] 繝�Eャ繧�E�繧�E�繝�E・繧剁E��懈�E縺励∪縺励◁E {backupPath}");
            return backupPath;
        }
        else
        {
            Debug.LogWarning($"[GameSetupEditor] 繝�Eャ繧�E�繧�E�繝�E・縺�E�菴懈�E縺�E�螟ｱ謨励�E�縺�E�縺励◁E {backupPath}");
            return null;
        }
    }

    /// <summary>UI 蟁E�EGameObject 繧剁E��懈�E縺励※隕ｪ縺�E�繧�E�繧�E�繝�Eメ縲・/summary>
    private static GameObject CreateUIChild(GameObject parent, string name)
    {
        var go = new GameObject(name);
        go.transform.SetParent(parent.transform, false);
        go.AddComponent<RectTransform>();
        return go;
    }

    /// <summary>RectTransform 縺�E�繧�E�繝ｳ繧�E�繝ｼ繧剁E���E�螟ｮ蝗ｺ螳壹・繧�E�繧�E�繧�E�繧呈欠螳壹☁E��九・/summary>
    private static void SetAnchor(GameObject go, Vector2 anchorCenter, Vector2 sizeDelta)
    {
        var rect = go.GetComponent<RectTransform>();
        rect.anchorMin = anchorCenter;
        rect.anchorMax = anchorCenter;
        rect.anchoredPosition = Vector2.zero;
        rect.sizeDelta = sizeDelta;
    }

    /// <summary>RectTransform 繧定ｦ�E�蜈ｨ菴薙�E蠑輔″莨�E�縺�E�縺呻�E�医・繧�E�繝ｳ蜀・ユ繧�E�繧�E�繝育畑�E峨・/summary>
    private static void SetAnchorFill(GameObject go)
    {
        var rect = go.GetComponent<RectTransform>();
        rect.anchorMin = Vector2.zero;
        rect.anchorMax = Vector2.one;
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
    }

