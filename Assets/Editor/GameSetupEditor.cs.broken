        // 笏笏 Step 11: PlayerInteract 縺�E� interactBlockerObjects 險�E�螳・笏笏笏
        var playerInteract = Object.FindFirstObjectByType<PlayerInteract>();
        if (playerInteract != null && buildModeBlocker != null)
        {
