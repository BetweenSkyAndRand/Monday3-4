        // Input System 繝代ャ繧�E�繝ｼ繧�E�菴�E�逕ｨ縺�E�縺溘ａEInputSystemUIInputModule 繧剁E���E�逕ｨ縺吶�E�E
        eventSystemGo.AddComponent<InputSystemUIInputModule>();

        // 笏笏 Canvas 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var canvasGo = new GameObject("Canvas");
        var canvas = canvasGo.AddComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        var scaler = canvasGo.AddComponent<CanvasScaler>();
        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920, 1080);
        canvasGo.AddComponent<GraphicRaycaster>();

        // 笏笏 GAME CLEAR 繝�Eく繧�E�繝�E笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var clearTextGo = CreateUIChild(canvasGo, "ClearText");
        SetAnchor(clearTextGo, new Vector2(0.5f, 0.72f), new Vector2(900f, 130f));
        var clearText = clearTextGo.AddComponent<TextMeshProUGUI>();
        clearText.text = "GAME CLEAR";
        clearText.fontSize = 84;
        clearText.alignment = TextAlignmentOptions.Center;
        clearText.color = new Color(1f, 0.85f, 0.1f);

        // 笏笏 闡嶺�E�懈ｨ�E�陦�E�遉ｺ 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var copyrightGo = CreateUIChild(canvasGo, "CopyrightText");
        SetAnchor(copyrightGo, new Vector2(0.5f, 0.5f), new Vector2(700f, 80f));
        var copyrightText = copyrightGo.AddComponent<TextMeshProUGUI>();
        copyrightText.text = "�E�ｩ 2026 MapTest Development Team";
        copyrightText.fontSize = 24;
        copyrightText.alignment = TextAlignmentOptions.Center;
        copyrightText.color = new Color(0.7f, 0.7f, 0.7f);

        // 笏笏 繧�E�繧�E�繝医Ν縺�E�謌ｻ繧九�E繧�E�繝ｳ 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var buttonGo = CreateUIChild(canvasGo, "ReturnToTitleButton");
        SetAnchor(buttonGo, new Vector2(0.5f, 0.2f), new Vector2(340f, 80f));
        var buttonImage = buttonGo.AddComponent<Image>();
        buttonImage.color = new Color(0.2f, 0.2f, 0.2f);
        var button = buttonGo.AddComponent<Button>();
        button.targetGraphic = buttonImage;

        var buttonTextGo = CreateUIChild(buttonGo, "ButtonText");
        SetAnchorFill(buttonTextGo);
        var buttonText = buttonTextGo.AddComponent<TextMeshProUGUI>();
        buttonText.text = "繧�E�繧�E�繝医Ν縺�E�謌ｻ繧・;
        buttonText.fontSize = 30;
        buttonText.alignment = TextAlignmentOptions.Center;
        buttonText.color = Color.white;

        // 笏笏 GameClearView 繧�E�繝ｳ繝昴・繝阪Φ繝郁�E��E�蜉 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var gameClearView = canvasGo.AddComponent<GameClearView>();

        // SerializedObject 邨檎罰縺�E�繝懊ち繝ｳ繧偵ぁE���E�繧�E�繝ｳ
        var serializedView = new SerializedObject(gameClearView);
        var buttonProp = serializedView.FindProperty("returnToTitleButton");
        if (buttonProp != null)
        {
            buttonProp.objectReferenceValue = button;
            serializedView.ApplyModifiedProperties();
            Debug.Log("[GameSetupEditor] GameClearView.returnToTitleButton 繧偵ぁE���E�繧�E�繝ｳ縺励∪縺励◁E��・);
        }
        else
        {
            Debug.LogWarning("[GameSetupEditor] returnToTitleButton 繝輔ぅ繝ｼ繝ｫ繝峨′隕九▽縺九ｊ縺�E�縺帙ｓ縲よ�E蜍輔〒繧�E�繧�E�繧�E�繝ｳ縺励※縺上□縺輔＞縲・);
        }

        // 笏笏 繧�E�繝ｼ繝ｳ菫晏ｭ・笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        EditorSceneManager.SaveScene(newScene, GameClearScenePath);
        AssetDatabase.Refresh();

        Debug.Log($"[GameSetupEditor] GameClearScene 繧剁E��懈�E縺励∪縺励◁E {GameClearScenePath}");
        EditorUtility.DisplayDialog(
            "螳御�E�・,
            $"GameClearScene 繧剁E��懈�E縺励∪縺励◁E��・n{GameClearScenePath}\n\n闡嶺�E�懈ｨ�E�陦�E�遉ｺ繝ｻ繧�E�繧�E�繝医Ν縺�E�謌ｻ繧九�E繧�E�繝ｳ縺悟ｮ溯�E�・�E�医∩縺�E�縺吶・n笞 闡嶺�E�懈ｨ�E�繝�Eく繧�E�繝医・ Canvas/CopyrightText 縺九ｉ邱�E�髮・�E�縺�E�縺上□縺輔＞縲・,
            "OK");
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 4. Build Settings 縺�E�蜈ｨ繧�E�繝ｼ繝ｳ繧堤匳骭�E�
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/04. Build Settings 縺�E�繧�E�繝ｼ繝ｳ繧堤匳骭�E�")]
    public static void RegisterScenesInBuildSettings()
    {
        var targetPaths = new[]
        {
            GameScenePath,
            GameOverScenePath,
            TitleScenePath,
            GameClearScenePath,
        };

        var currentScenes = EditorBuildSettings.scenes.ToList();
        var currentPaths = new HashSet<string>(currentScenes.Select(s => s.path));

        var addedPaths = new List<string>();
        var skippedPaths = new List<string>();

        foreach (var path in targetPaths)
        {
            if (currentPaths.Contains(path))
            {
                Debug.Log($"[GameSetupEditor] 譌｢縺�E�逋ｻ骭�E�貂医∩・医せ繧�E�繝�E・・・ {path}");
                continue;
            }

            if (!System.IO.File.Exists(path))
            {
                skippedPaths.Add(path);
                Debug.LogWarning($"[GameSetupEditor] 繝輔ぃ繧�E�繝ｫ縺悟ｭ伜惠縺励↑縺・◁E��√せ繧�E�繝�E・・亥・縺�E�繧�E�繝ｼ繝ｳ菴懈�E縺励※縺上□縺輔＞�E・ {path}");
                continue;
            }

            currentScenes.Add(new EditorBuildSettingsScene(path, enabled: true));
            addedPaths.Add(path);
        }

        EditorBuildSettings.scenes = currentScenes.ToArray();

        var message = $"Build Settings 繧呈峩譁E��縺励∪縺励◁E��・n\n" +
                      $"笨・霑ｽ蜉: {addedPaths.Count} 繧�E�繝ｼ繝ｳ\n" +
                      string.Join("\n", addedPaths.Select(p => $"  窶�E� {p}"));

        if (skippedPaths.Count > 0)
        {
            message += $"\n\n笞 繝輔ぃ繧�E�繝ｫ譛ｪ蟁E��惠縺�E�縺溘ａ繧�E�繧�E�繝�E・: {skippedPaths.Count} 繧�E�繝ｼ繝ｳ\n" +
                       string.Join("\n", skippedPaths.Select(p => $"  窶�E� {p}")) +
                       "\n\n繝｡繝九Η繝ｼ 1縲・ 縺�E�繧�E�繝ｼ繝ｳ繧貞�E縺�E�菴懈�E縺励※縺九ｉ蜀榊ｮ溯�E�後＠縺�E�縺上□縺輔＞縲・;
        }

        Debug.Log($"[GameSetupEditor] Build Settings 譖ｴ譁E��螳御�E�・りｿ�E�蜉: {addedPaths.Count} / 繧�E�繧�E�繝�E・: {skippedPaths.Count}");
        EditorUtility.DisplayDialog("Build Settings 譖ｴ譁E��螳御�E�・, message, "OK");
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 5. 螳晉ｮ�E�繝励Ξ繝上ヶ繧定�E蜍�E函謌�E
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/05. 螳晉ｮ�E�繝励Ξ繝上ヶ繧剁E��懈�E")]
    public static void CreateTreasureBoxPrefab()
    {
        if (System.IO.File.Exists(TreasureBoxPrefabPath))
        {
            if (!EditorUtility.DisplayDialog(
                    "遒ｺ隱・,
                    $"{TreasureBoxPrefabPath} 縺�E�譌｢縺�E�蟁E��惠縺励∪縺吶めE��頑嶌縺阪�E�縺�E�縺吶°・・,
                    "荳頑嶌縺・, "繧�E�繝｣繝ｳ繧�E�繝ｫ"))
            {
                return;
            }
        }

        // 繝励Ξ繝上ヶ菫晏ｭ伜�E繝輔か繝ｫ繝繧堤�E��E�隱阪・菴懈�E
        const string prefabFolder = "Assets/Game/Room/Prefabs";
        if (!AssetDatabase.IsValidFolder(prefabFolder))
        {
            AssetDatabase.CreateFolder("Assets/Game/Room", "Prefabs");
            Debug.Log($"[GameSetupEditor] 繝輔か繝ｫ繝繧剁E��懈�E縺励∪縺励◁E {prefabFolder}");
        }

        // 螳晉ｮ�E� GameObject 繧剁E��懈�E
        var treasureBoxGo = new GameObject("TreasureBox");

        // 笏笏 3D隕九◆逶�E�・・ube・俁E��笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        // 繝｢繝�EΝ譛ｪ遒ｺ螳壹・縺溘ａ莉�E�縺�E�Cube繧剁E���E�逕ｨ縲めE��繧・≧縺弱�E�E��薙�E繝｢繝�EΝ驕ｸ螳壼�E�後�E蟾�E�縺玲崛縺医�E�縺薙�E縲・
        var meshFilter = treasureBoxGo.AddComponent<MeshFilter>();
        meshFilter.sharedMesh = Resources.GetBuiltinResource<Mesh>("Cube.fbx");
        var meshRenderer = treasureBoxGo.AddComponent<MeshRenderer>();
        // 襍､濶�E�繝槭ユ繝ｪ繧�E�繝ｫ繧剁E��懈�E・井ｻ墓ｧ・ 螳晉ｮ�E�縺�E�襍､・・
        var redMaterial = new Material(Shader.Find("Universal Render Pipeline/Lit"));
        redMaterial.color = new Color(0.8f, 0.1f, 0.1f);
        meshRenderer.sharedMaterial = redMaterial;

        // 螳晉ｮ�E�繧峨�E�縺・せ繧�E�繝ｼ繝ｫ縺�E�險�E�螳夲�E�・.8 x 0.6 x 0.8・・
        treasureBoxGo.transform.localScale = new Vector3(0.8f, 0.6f, 0.8f);

        // 笏笏 BoxCollider・・layerInteract 縺�E� OverlapSphere 縺�E�讀懷・縺輔ｌ繧九◆繧√�E蠢・�E�茨�E�俁E��笏
        var boxCollider = treasureBoxGo.AddComponent<BoxCollider>();
        boxCollider.isTrigger = false; // IsTrigger=false 縺�E�髫懷�E��E�迚ｩ縺�E�縺励※讖溯・縺輔○繧・

        // 笏笏 TreasureBoxController 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        treasureBoxGo.AddComponent<TreasureBoxController>();

        // 笏笏 繝励Ξ繝上ヶ縺�E�縺励※菫晏ｭ・笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        var prefab = PrefabUtility.SaveAsPrefabAsset(treasureBoxGo, TreasureBoxPrefabPath);
        Object.DestroyImmediate(treasureBoxGo);
        AssetDatabase.Refresh();

        if (prefab != null)
        {
            Debug.Log($"[GameSetupEditor] 螳晉ｮ�E�繝励Ξ繝上ヶ繧剁E��懈�E縺励∪縺励◁E {TreasureBoxPrefabPath}");
            EditorUtility.DisplayDialog(
                "螳御�E�・,
                $"螳晉ｮ�E�繝励Ξ繝上ヶ繧剁E��懈�E縺励∪縺励◁E��・n{TreasureBoxPrefabPath}\n\n" +
                "笞 迴�E�蝨�E�縺�E�莉ｮ縺�E�襍､縺Гube縺�E�縺吶めE��繧・≧縺弱�E�E��薙�E繝｢繝�EΝ驕ｸ螳壼�E�後�E蟾�E�縺玲崛縺医※縺上□縺輔＞縲・n" +
                "谺�E�縺�E� RoomObjectSpawner 縺�E� Treasure Box Prefab 縺�E�繧�E�繧�E�繧�E�繝ｳ縺励※縺上□縺輔＞�E医Γ繝九Η繝ｼ6縺�E�閾�E�蜍�E�E��E�螳壼庁E�E峨・,
                "OK");
        }
        else
        {
            Debug.LogError("[GameSetupEditor] 螳晉ｮ�E�繝励Ξ繝上ヶ縺�E�菴懈�E縺�E�螟ｱ謨励�E�縺�E�縺励◁E��・);
        }
    }

    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
    // 6. GameScene 螳悟�E繧�E�繝�Eヨ繧�E�繝�E・・医ヲ繧�E�繝ｩ繝ｫ繧�E�繝ｼ蜀咲樁E+ Inspector 險�E�螳夲�E�・
    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/06. GameScene 螳悟�E繧�E�繝�Eヨ繧�E�繝�E・・医ヲ繧�E�繝ｩ繝ｫ繧�E�繝ｼ蜀咲樟�E・)]
    public static void SetupGameSceneInspector()
    {
        if (!System.IO.File.Exists(GameScenePath))
        {
            EditorUtility.DisplayDialog("Info", "Operation completed", "OK");
            return;
        }

        if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo())
        {
            return;
        }

        // 笏笏 Step 0: GameScene 縺�E�繝�Eャ繧�E�繧�E�繝�E・繧剁E��懈�E 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        // 繧�E�繝�Eヨ繧�E�繝�E・蜑阪・迥�E�諷九ａEBackups 繝輔か繝ｫ繝縺�E�繧�E�繧�E�繝繧�E�繧�E�繝ｳ繝嶺�E�倥″縺�E�菫晏ｭ倥☁E��九・
        CreateGameSceneBackup();

        // 笏笏 GameScene 繧帝幕縺・笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
        // 譌｢縺�E� GameScene 縺後い繧�E�繝�EぁE��悶↑蝣�E�蜷医・ OpenSceneMode.Single 縺�E�蜀崎ｪ�E�縺�E�霎ｼ縺�E�縺帙�E
        // 縺昴・縺�E�縺�E�菴�E�逕ｨ縺吶�E�縲�E�ingle 縺�E�髢九￥縺�E�繧�E�繝ｼ繝ｳ荳翫・譛ｪ菫晏ｭ倥が繝悶ず繧�E�繧�E�繝医′豸医∴繧九◆繧√・
        var activeScene = SceneManager.GetActiveScene();
        var gameScene = activeScene.path == GameScenePath
            ? activeScene
            : EditorSceneManager.OpenScene(GameScenePath, OpenSceneMode.Additive);

        if (activeScene.path != GameScenePath)
        {
            SceneManager.SetActiveScene(gameScene);
        }

        var log = new System.Text.StringBuilder();
        log.AppendLine("[GameSetupEditor] GameScene 螳悟�E繧�E�繝�Eヨ繧�E�繝�E・髢句�E�・);
        log.AppendLine("笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏");

        // 笏笏 Step 1: TreasureBox 繝励Ξ繝上ヶ繧堤�E��E�隱阪・菴懈�E 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
