        inventoryText.text = "縲先怙邨めE�E謖�E■迚ｩ縲曾n・域收蟁E��縺輔ｓ縺�E�繧�E�繝ｳ繝吶Φ繝医Μ螳溯�E�・�E�後�E陦�E�遉ｺ・・;
        inventoryText.fontSize = 26;
        inventoryText.alignment = TextAlignmentOptions.Center;
        inventoryText.color = new Color(0.85f, 0.85f, 0.85f);

        // 笏笏 繧�E�繧�E�繝医Ν縺�E�謌ｻ繧九�E繧�E�繝ｳ 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏
