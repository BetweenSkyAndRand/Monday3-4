    // 笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏笏

    [MenuItem("Tools/Game Setup/[ALL] 荳願ｨ倥�E�縺吶∋縺�E�螳溯�E�・)]
    public static void RunAll()
    {
        if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo())
        {
            return;
        }

        if (!System.IO.File.Exists(GameOverScenePath))
        {
            CreateGameOverScene();
        }
        else
        {
            Debug.Log("[GameSetupEditor] GameOverScene 縺�E�譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
        }

        if (!System.IO.File.Exists(TitleScenePath))
        {
            CreateTitleScene();
        }
        else
        {
            Debug.Log("[GameSetupEditor] TitleScene 縺�E�譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
        }

        if (!System.IO.File.Exists(GameClearScenePath))
        {
            CreateGameClearScene();
        }
        else
        {
            Debug.Log("[GameSetupEditor] GameClearScene 縺�E�譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
        }

        RegisterScenesInBuildSettings();

        // InputModule 繧・InputSystem 蟁E��蠢懊�E蟾�E�縺玲崛縺医�E��E域里蟁E��す繝ｼ繝ｳ繧めE��繧・・
        FixInputModuleForAllScenes();

        // 譌･譛ｬ隱槭ヵ繧�E�繝ｳ繝医そ繝�Eヨ繧�E�繝�E・・医∪縺�E�菴懈�E縺輔ｌ縺�E�縺・↑縺・�E��E�蜷医・縺�E�・・
        if (!System.IO.File.Exists(JapaneseFontAssetPath))
        {
            SetupJapaneseFont();
        }
        else
        {
            Debug.Log("[GameSetupEditor] 譌･譛ｬ隱槭ヵ繧�E�繝ｳ繝医・譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
        }

        // LocalizationData 菴懈�E・医∪縺�E�菴懈�E縺輔ｌ縺�E�縺・↑縺・�E��E�蜷医・縺�E�・・
        if (!System.IO.File.Exists(LocalizationDataPath))
        {
            CreateLocalizationDataAsset();
        }
        else
        {
            Debug.Log("[GameSetupEditor] LocalizationData 縺�E�譌｢縺�E�蟁E��惠縺励∪縺呻�E�医せ繧�E�繝�E・・峨・);
        }

        // TitleScene 縺�E�險隱朸I霑ｽ蜉
        AddLanguageUIToTitleScene();

        // GameScene 縺�E� LanguageManager 霑ｽ蜉
        AddLanguageManagerToGameScene();

        // 螳晉ｮ�E�繝励Ξ繝上ヶ縺�E� SetupGameSceneInspector 蜀・・ Step 1 縺�E�閾�E�蜍穂ｽ懈�E縺輔ｌ繧九◆繧∝句挨蜻�E�縺�E�蜁E��縺嶺�E�崎ｦ・
        SetupGameSceneInspector();
